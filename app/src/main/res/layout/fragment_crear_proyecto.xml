<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".crear_proyecto"
    android:orientation="vertical"
    android:background="@color/white">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_left"
            android:layout_marginLeft="20dp"
            android:clickable="true"
            android:id="@+id/np_btn_regresar"
            android:visibility="gone"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nuevo Proyecto             "
            android:textSize="25sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginTop="15dp"
            android:textAlignment="textEnd"/>
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="9"
        android:backgroundTint="@color/white"
        android:elevation="20dp"
        app:cardCornerRadius="20dp"
        android:layout_margin="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ICONO DEL PROYECTO"
                android:textColor="@color/gray"
                android:textStyle="bold"
                android:layout_margin="20dp"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:layout_margin="10dp"
                android:gravity="center_horizontal">
                <androidx.cardview.widget.CardView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardCornerRadius="10dp"
                    android:clickable="true"
                    android:elevation="20dp"
                    android:id="@+id/np_btnphone"
                    app:cardBackgroundColor="@color/white"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_phone"
                            />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardCornerRadius="10dp"
                    android:clickable="true"
                    android:layout_marginLeft="20dp"
                    android:elevation="20dp"
                    android:id="@+id/np_btncar"
                    app:cardBackgroundColor="@color/white"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_car"
                            />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardCornerRadius="10dp"
                    android:clickable="true"
                    android:layout_marginLeft="20dp"
                    android:elevation="20dp"
                    android:id="@+id/np_btnanimal"
                    app:cardBackgroundColor="@color/white"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_animal"
                            />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardCornerRadius="10dp"
                    android:clickable="true"
                    android:layout_marginLeft="20dp"
                    android:elevation="20dp"
                    android:id="@+id/np_btntag"
                    app:cardBackgroundColor="@color/white"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_tag"
                            />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOMBRE DEL PROYECTO (ITEM)"
                android:textColor="@color/gray"
                android:textStyle="bold"
                android:layout_margin="20dp"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:backgroundTint="@color/light_gray"
                app:cardCornerRadius="10dp"
                >
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="     Ej. iPhone 12 Pro Max"
                    android:textColorHint="@color/light_gray"
                    android:textColor="@color/black"
                    android:background="@drawable/bg_edit_text"
                    android:layout_margin="1dp"
                    android:id="@+id/np_txtitem"
                    android:maxLines="1"
                    android:ellipsize="end"
                    />
            </androidx.cardview.widget.CardView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRECIO ESTIMADO DE VENTA ($)"
                android:textColor="@color/gray"
                android:textStyle="bold"
                android:layout_margin="20dp"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:backgroundTint="@color/light_gray"
                app:cardCornerRadius="10dp"
                >
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="     Para calcular proyecciones"
                    android:textColorHint="@color/light_gray"
                    android:textColor="@color/black"
                    android:background="@drawable/bg_edit_text"
                    android:layout_margin="1dp"
                    android:id="@+id/np_txtprecio_est"
                    android:inputType="numberDecimal"
                    android:ellipsize="end"
                    android:maxLines="1"
                    />
            </androidx.cardview.widget.CardView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DETALLES (FALLAS, ESTADO ...)"
                android:textColor="@color/gray"
                android:textStyle="bold"
                android:layout_margin="20dp"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:backgroundTint="@color/light_gray"
                app:cardCornerRadius="10dp"
                >
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:hint="Breve descripción del estado actual"
                    android:textColorHint="@color/light_gray"
                    android:textColor="@color/black"
                    android:background="@drawable/bg_spinner"
                    android:layout_margin="1dp"
                    android:id="@+id/np_txtdetalles"
                    android:maxLines="2"
                    android:ellipsize="end"
                    />
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                app:cardCornerRadius="15dp"
                android:elevation="20dp"
                android:clickable="true"
                android:id="@+id/np_btn_crear"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:background="@color/boton_sec">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Crear Proyecto"
                        android:textColor="@color/white"
                        android:layout_margin="15dp"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.cardview.widget.CardView>


</LinearLayout>