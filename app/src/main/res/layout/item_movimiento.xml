<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/item_proyecto"
    app:cardCornerRadius="20dp"
    app:cardElevation="30dp"
    android:backgroundTint="@color/white"
    android:layout_margin="5dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        >
        <androidx.cardview.widget.CardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="8dp"
            android:layout_gravity="center"
            android:layout_margin="15dp"
            app:cardBackgroundColor="@color/rojo_claro"
            android:id="@+id/it_movimeinto_bg_img"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_arrowdownright"
                    android:layout_margin="10dp"
                    android:id="@+id/it_movimeinto_img"
                    />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:gravity="center_vertical"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mano de obra"
                android:textColor="@color/black"
                android:maxLines="1"
                android:ellipsize="end"
                android:textStyle="bold"
                android:id="@+id/it_movimiento_txtnombre"
                android:layout_marginTop="10dp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Compra para reventa"
                android:textColor="@color/gray"
                android:id="@+id/it_movimiento_txtdescripcion"
                android:layout_marginTop="10dp"
                android:maxLines="1"
                android:ellipsize="end"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-$4,000.00"
                android:maxLines="1"
                android:ellipsize="end"
                android:textStyle="bold"
                android:textSize="15sp"
                android:id="@+id/it_movimiento_txtmonto"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 abr 2026"
                android:textSize="10sp"
                android:textColor="@color/light_gray"
                android:maxLines="1"
                android:ellipsize="end"
                android:id="@+id/it_movimeinto_txtfecha"
                />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
